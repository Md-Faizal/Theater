# Threater Virtual Cinema Environment Configuration (Template)

PORT=3030
THREATER_ADDR=0.0.0.0:3030
DATABASE_URL=sqlite:///app/data/threater.db
CLIENT_DIST=/app/client/dist
THREATER_DEV_AUTH=false
THREATER_COOKIE_SECURE=true
RUST_LOG=info

# Google OAuth 2.0 Credentials (Set in .env on the server)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
